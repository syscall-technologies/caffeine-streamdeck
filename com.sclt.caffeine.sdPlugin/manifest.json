{
  "SDKVersion": 2,
  "UUID": "com.sclt.caffeine",
  "Name": "Caffeine",
  "Version": "1.0.0.0",
  "Author": "0xSeb",
  "Description": "Keep the Mac awake (caffeinate -di) while the key is on.",
  "Icon": "imgs/plugin",
  "Category": "Caffeine",
  "CategoryIcon": "imgs/category",
  "CodePath": "plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Actions": [
    {
      "UUID": "com.sclt.caffeine.toggle",
      "Name": "Toggle",
      "Tooltip": "Keep the Mac awake while on",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/off"
        },
        {
          "Image": "imgs/on"
        }
      ]
    }
  ]
}